import pandas as pd 
import numpy as np 
import streamlit as st 

st.title("mark's dangerous app") 

DATA_COLUMN = 'date/time' 
DATA_LINK = 'uber-raw-data-sep14.csv.gz' 

@st.cache_data 
def data_fetcher(nrows): 
    data = pd.read_csv(DATA_LINK, nrows=nrows) 
    lowercase = lambda x: str(x).lower() 
    data.rename(lowercase, axis='columns', inplace=True)
    data[DATA_COLUMN] = pd.to_datetime(data[DATA_COLUMN]) 
    return data 


data_load = st.text("Loading stuffffff ... bleeeeeeeeeeeeeeeeeeeeh") 
data = data_fetcher(10000) 
data_load.text("Done! Loaded with st.cache_data!")

st.subheader("Number of pick ups by hour")
hist_values = np.histogram(data[DATA_COLUMN].dt.hour, bins=24, range=(0,24))[0]

# Fixed the typo here
st.bar_chart(hist_values)